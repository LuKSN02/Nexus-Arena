// firestore.rules
// --------------------------------------------------------------------------
// Cole isto no Console do Firebase em: Firestore Database → Regras.
// São as regras mínimas para o app funcionar com o modelo de dados usado
// em js/db.js. Ajuste antes de abrir o projeto para o público em geral —
// isto é uma base sólida para uso pessoal/demonstração, não uma auditoria
// de segurança completa.
// --------------------------------------------------------------------------

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Perfis: leitura de documento único (get) exige login — usada para
    // carregar o perfil de alguém já autenticado. Já a leitura em lista
    // (list) precisa ficar aberta mesmo sem login, porque é o que checa
    // se um nome de usuário/e-mail já existe DURANTE o cadastro, antes
    // de o usuário estar autenticado. Limitamos a 1 resultado por query
    // para não permitir listar/baixar a coleção inteira de perfis.
    match /users/{uid} {
      allow get: if request.auth != null;
      allow list: if request.query.limit <= 1;
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null && request.auth.uid == uid;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Comentários: leitura pública, criação exige login e dono correto.
    // Update só é permitido para curtir (campo "likes") OU pelo autor.
    match /comments/{id} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow update: if request.auth != null && (
        request.auth.uid == resource.data.userId ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes'])
      );
      allow delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    // Curtidas de notícia — documento por artigo, só o array de uids.
    match /articleLikes/{articleId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Avaliações de produto: leitura pública, escrita só pelo autor.
    match /reviews/{id} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    // Pedidos: só o dono lê/cria os próprios (tem endereço, é dado sensível).
    match /orders/{id} {
      allow read: if request.auth != null && request.auth.uid == resource.data.ownerKey;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.ownerKey;
    }

    // Carrinho e lista de desejos: doc ID = uid do dono.
    match /carts/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /wishlists/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /bookmarks/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /seasonPasses/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Notificações: só o dono lê/edita as próprias.
    match /notifications/{id} {
      allow read: if request.auth != null && request.auth.uid == resource.data.ownerKey;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.ownerKey;
      allow update: if request.auth != null && request.auth.uid == resource.data.ownerKey;
    }

    // Newsletter: qualquer usuário logado pode se inscrever (create). A
    // LEITURA da lista completa de e-mails é restrita ao(s) admin(s) da
    // Nexus Arena — troque o e-mail abaixo pelo mesmo que está em
    // ADMIN_EMAILS no js/app.js. Sem isso, qualquer usuário logado
    // conseguiria ler a lista de e-mails inscritos pelo console do
    // navegador, o que seria um vazamento de dados dos seus usuários.
    match /newsletterSubs/{email} {
      allow create: if request.auth != null;
      allow read: if request.auth != null && request.auth.token.email == 'trajano.neves01@gmail.com';
      allow update, delete: if false;
    }

    // Notícias reais cadastradas pelo admin (as de demonstração ficam no
    // código, em data.js, e não passam por aqui). Leitura pública, como
    // as demais notícias; escrita restrita ao e-mail admin — troque pelo
    // mesmo e-mail usado em ADMIN_EMAILS no js/app.js.
    match /articles/{id} {
      allow read: if true;
      allow create, update, delete: if request.auth != null
        && request.auth.token.email == 'trajano.neves01@gmail.com';
    }

    // Trava do seed de conteúdo de demonstração — qualquer um lê,
    // ninguém além do próprio app cria (roda 1x só).
    match /meta/{docId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }

    // Central da Comunidade: posts de notícia/vídeo enviados por usuários.
    // Leitura pública (o app filtra por status=='approved' na query pro
    // feed público, e por authorId==uid pra aba "Meus posts"/pendentes —
    // sem isso a query nem completa, mas a regra em si não restringe
    // leitura porque não há nada sensível no documento).
    // Criação: só o próprio autor, e sempre nasce como 'pending' (a
    // aprovação/rejeição é feita só depois, via update).
    // Update: o autor só pode editar enquanto ainda 'pending' (sem trocar
    // o status nem o authorId); votos (upvotes/downvotes) qualquer
    // logado pode mexer, desde que só esses dois campos mudem; e só o(s)
    // e-mail(s) admin pode aprovar/rejeitar mudando o status.
    match /communityPosts/{id} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update: if request.auth != null && (
        (resource.data.authorId == request.auth.uid
          && resource.data.status == 'pending'
          && request.resource.data.status == 'pending'
          && request.resource.data.authorId == request.auth.uid) ||
        request.auth.token.email == 'trajano.neves01@gmail.com' ||
        (request.auth.uid != resource.data.authorId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['upvotes', 'downvotes']))
      );
      allow delete: if request.auth != null && (
        resource.data.authorId == request.auth.uid ||
        request.auth.token.email == 'trajano.neves01@gmail.com'
      );
    }
  }
}
