// firestore.rules
// --------------------------------------------------------------------------
// Cole isto no Console do Firebase em: Firestore Database → Regras.
// São as regras mínimas para o app funcionar com o modelo de dados usado
// em js/db.js. Ajuste antes de abrir o projeto para o público em geral —
// isto é uma base sólida para uso pessoal/demonstração, não uma auditoria
// de segurança completa.
// --------------------------------------------------------------------------

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- funções auxiliares ----
    // Admin = e-mail do dono E e-mail VERIFICADO. Sem a verificação, alguém
    // poderia criar uma conta e-mail/senha com o e-mail do admin e herdar o
    // acesso. (Contas Google já vêm verificadas; as de e-mail/senha precisam
    // clicar no link que o app envia no cadastro.)
    function isAdmin(){
      return request.auth != null
        && request.auth.token.email == 'trajano.neves01@gmail.com'
        && request.auth.token.email_verified == true;
    }
    // Avatar só pode ser data:image/... ou https://... sem aspas, <, > ou
    // espaços — evita injetar HTML/atributos (XSS) por esse campo.
    function validAvatar(a){
      return a is string && a.size() < 60000
        && a.matches('(data:image/|https://)[^"\'<> ]*');
    }
    // Equipar item cosmético: só se o campo mudou para null ou para algo que o
    // dono já desbloqueou (lista que só o Worker escreve).
    function equipOk(field, listField){
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([field])
        || request.resource.data.get(field, null) == null
        || request.resource.data.get(field, null) in resource.data.get(listField, []);
    }
    function validVideoUrl(u){
      return u == null || (u is string && u.size() < 500 && u.matches('https?://[^"\'<> ]+'));
    }

    // Perfis: só o próprio dono lê o documento (tem e-mail, moedas...).
    // ECONOMIA: moedas, emblemas, itens desbloqueados, bônus diário e sequência
    // só o Worker (conta de serviço, que ignora estas regras) escreve. O
    // navegador só pode equipar o que já está desbloqueado.
    // NÃO existe leitura em lista (evita varrer todos os e-mails); a checagem
    // de "nome livre" usa a coleção pública "usernames".
    match /users/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.coins == 0
        && request.resource.data.get('badges', []).toSet().hasOnly(['founder'])
        && request.resource.data.get('unlockedFrames', []).size() == 0
        && request.resource.data.get('activeFrame', null) == null
        && !request.resource.data.keys().hasAny(['unlockedBanners', 'unlockedTitles', 'activeBanner', 'activeTitle', 'lastDailyBonus', 'dailyStreak'])
        && validAvatar(request.resource.data.avatar);
      allow update: if request.auth != null && request.auth.uid == uid
        && !request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(['email', 'emailLower', 'username', 'usernameLower', 'tag', 'discordId', 'authProvider', 'createdAt',
                      'coins', 'badges', 'unlockedFrames', 'unlockedBanners', 'unlockedTitles', 'lastDailyBonus', 'dailyStreak'])
        && equipOk('activeFrame', 'unlockedFrames')
        && equipOk('activeBanner', 'unlockedBanners')
        && equipOk('activeTitle', 'unlockedTitles')
        && validAvatar(request.resource.data.avatar);
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Nomes de usuário: leitura documento a documento (get), qualquer um —
    // necessário para checar disponibilidade no cadastro. Só se cria uma vez
    // (não existe update), e só o dono libera o nome.
    match /usernames/{name} {
      allow get: if true;
      allow list: if false;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid;
      allow update: if false;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // Comentários: leitura pública, criação exige login e dono correto.
    // Update só é permitido para curtir (campo "likes") OU pelo autor.
    match /comments/{id} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId
        && validAvatar(request.resource.data.avatar);
      // Autor só edita o texto; qualquer logado só mexe em "likes".
      allow update: if request.auth != null && (
        (request.auth.uid == resource.data.userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text'])) ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes'])
      );
      allow delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    // Curtidas de notícia — documento por artigo, só o array de uids.
    // Cada pessoa só pode adicionar OU remover o PRÓPRIO uid do array
    // (antes, qualquer logado podia apagar todas as curtidas ou forjar uids).
    match /articleLikes/{articleId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['userIds'])
        && request.resource.data.userIds.toSet().hasOnly([request.auth.uid]);
      allow update: if request.auth != null
        && request.resource.data.keys().hasOnly(['userIds'])
        && request.resource.data.userIds.toSet().difference(resource.data.userIds.toSet()).hasOnly([request.auth.uid])
        && resource.data.userIds.toSet().difference(request.resource.data.userIds.toSet()).hasOnly([request.auth.uid]);
      allow delete: if false;
    }

    // Contador de comentários por notícia: só muda de 1 em 1.
    match /articleStats/{articleId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['commentCount'])
        && request.resource.data.commentCount == 1;
      allow update: if request.auth != null
        && request.resource.data.keys().hasOnly(['commentCount'])
        && request.resource.data.commentCount >= 0
        && (request.resource.data.commentCount - resource.data.get('commentCount', 0) in [-1, 1]);
      allow delete: if false;
    }

    // Avaliações de produto: leitura pública, escrita só pelo autor.
    match /reviews/{id} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId
        && validAvatar(request.resource.data.avatar);
      allow update: if request.auth != null && request.auth.uid == resource.data.userId
        && validAvatar(request.resource.data.avatar);
      allow delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    // Pedidos: só o dono lê/cria os próprios (tem endereço, é dado sensível).
    match /orders/{id} {
      allow read: if request.auth != null && request.auth.uid == resource.data.ownerKey;
      // paymentStatus/rewardsGranted só o servidor escreve (não há regra de update).
      allow create: if request.auth != null && request.auth.uid == request.resource.data.ownerKey
        && !request.resource.data.keys().hasAny(['rewardsGranted', 'paymentStatus']);
      // Excluir a própria conta apaga também os pedidos (ver Api.deleteAccount).
      allow delete: if request.auth != null && request.auth.uid == resource.data.ownerKey;
    }

    // Carrinho e lista de desejos: doc ID = uid do dono.
    match /carts/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /wishlists/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /bookmarks/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Passe de Batalha: XP, nível e resgates são do Worker; o dono só lê (e
    // apaga ao excluir a conta).
    match /seasonPasses/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if false;
    }

    // Notificações: só o dono lê/edita as próprias.
    match /notifications/{id} {
      allow read: if request.auth != null && request.auth.uid == resource.data.ownerKey;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.ownerKey;
      allow update: if request.auth != null && request.auth.uid == resource.data.ownerKey;
      allow delete: if request.auth != null && request.auth.uid == resource.data.ownerKey;
    }

    // Newsletter com confirmação por e-mail (double opt-in): o navegador NÃO
    // escreve aqui. A inscrição pendente vive em "newsletterPending" (sem
    // acesso do cliente) e o Worker só cria o documento em "newsletterSubs"
    // quando a pessoa clica no link do e-mail. Leitura/remoção: só o admin
    // (o disparo em massa precisa da lista e do token de cancelamento).
    match /newsletterSubs/{email} {
      allow read, delete: if isAdmin();
      allow create, update: if false;
    }
    match /newsletterPending/{email} {
      allow read, write: if false;
    }

    // Notícias reais cadastradas pelo admin (as de demonstração ficam no
    // código, em data.js, e não passam por aqui). Leitura pública, como
    // as demais notícias; escrita restrita ao e-mail admin — troque pelo
    // mesmo e-mail usado em ADMIN_EMAILS no js/app.js.
    match /articles/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Central da Comunidade: posts de notícia/vídeo enviados por usuários.
    // Leitura pública (o app filtra por status=='approved' na query pro
    // feed público, e por authorId==uid pra aba "Meus posts"/pendentes —
    // sem isso a query nem completa, mas a regra em si não restringe
    // leitura porque não há nada sensível no documento).
    // Criação: só o próprio autor, e sempre nasce como 'pending' (a
    // aprovação/rejeição é feita só depois, via update).
    // Update: o autor só pode editar enquanto ainda 'pending' (sem trocar
    // o status nem o authorId); votos (upvotes/downvotes) qualquer
    // logado pode mexer, desde que só esses dois campos mudem; e só o(s)
    // e-mail(s) admin pode aprovar/rejeitar mudando o status.
    match /communityPosts/{id} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.status == 'pending'
        && validVideoUrl(request.resource.data.videoUrl)
        && validAvatar(request.resource.data.authorAvatar);
      allow update: if request.auth != null && (
        (resource.data.authorId == request.auth.uid
          && resource.data.status == 'pending'
          && request.resource.data.status == 'pending'
          && request.resource.data.authorId == request.auth.uid
          && validVideoUrl(request.resource.data.videoUrl)) ||
        isAdmin() ||
        (request.auth.uid != resource.data.authorId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['upvotes', 'downvotes']))
      );
      allow delete: if request.auth != null && (
        resource.data.authorId == request.auth.uid ||
        isAdmin()
      );
    }
  }
}
